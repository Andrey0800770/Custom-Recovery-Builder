# mount point       fstype    device                                                                flags
/boot               emmc      /dev/block/bootdevice/by-name/boot                                    flags=display="Boot";backup=1;flashimg=1;
/recovery           emmc      /dev/block/bootdevice/by-name/recovery                                flags=display="Recovery";backup=1;flashimg=1;
/system             auto      /dev/block/bootdevice/by-name/system                                  flags=display="System";backup=1;
/system_image       emmc      /dev/block/bootdevice/by-name/system                                  flags=display="System image";backup=1;flashimg=1;
/data               auto      /dev/block/bootdevice/by-name/userdata                                flags=display="Data";
/cache              auto      /dev/block/bootdevice/by-name/cache                                   flags=display="Cache";
/vendor             ext4      /dev/block/bootdevice/by-name/vendor                                  flags=display="Vendor";backup=1;
/vendor_image       emmc      /dev/block/bootdevice/by-name/vendor                                  flags=display="Vendor image";backup=1;flashimg=1;
/odm                ext4      /dev/block/bootdevice/by-name/odm                                     flags=display="Odm";backup=1;
/odm_image          emmc      /dev/block/bootdevice/by-name/odm                                     flags=display="Odm image";backup=1;flashimg=1;
/efs		    emmc      /dev/block/bootdevice/by-name/efs					    flags=backup=1;display="EFS"
/firmware	    emmc      /dev/block/bootdevice/by-name/apnhlos				    flags=backup=1;display="Firmware"
/modem		    emmc      /dev/block/bootdevice/by-name/modem				    flags=backup=1;display="Modem"
/dsp		    emmc      /dev/block/bootdevice/by-name/dsp
/misc		    emmc      /dev/block/bootdevice/by-name/misc
/persist	    ext4      /dev/block/bootdevice/by-name/persis

# Removable storage
/external_sd	    vfat      /dev/block/mmcblk0p1	/dev/block/mmcblk0			    flags=storage;wipeingui;removable
/usb-otg	    auto      /dev/block/sde1	/dev/block/sde					    flags=display="USB-OTG";storage;wipeingui;removable
